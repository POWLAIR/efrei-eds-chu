# Copier vers .env et adapter :  cp .env.example .env

# --- ClickHouse (entrepôt) ---
CH_HOST=localhost
CH_HTTP_PORT=8123
CH_TCP_PORT=9000
CH_USER=eds
CH_PASSWORD=eds
CH_DATABASE=default

# Users lecture seule créés par `make init-db` (cloisonnement pilotage / recherche)
CH_RO_PILOTAGE_USER=ro_pilotage
CH_RO_PILOTAGE_PASSWORD=pilotage
CH_RO_RECHERCHE_USER=ro_recherche
CH_RO_RECHERCHE_PASSWORD=recherche

# --- Pseudonymisation (RGPD) ---
# Sel secret du hachage déterministe de l'identifiant patient.
# NE PAS committer la vraie valeur. La perte du sel = perte des jointures historiques.
PSEUDO_SALT=change-me-en-un-secret-long-et-aleatoire

# Seuil k-anonymat : cohortes strictement inférieures non diffusées en recherche
K_ANON_MIN=5

# --- Chemins ---
SOURCE_FILESTORAGE=./data/source-filestorage
LAKE_DIR=./data/lake

# --- Metabase ---
MB_PORT=3000
MB_URL=http://localhost:3000

# Compte admin créé au 1er lancement par `make dashboards`
MB_ADMIN_EMAIL=admin@chu.local
MB_ADMIN_PASSWORD=metabaseadmin1
MB_ADMIN_FIRST_NAME=Admin
MB_ADMIN_LAST_NAME=EDS

# Comptes de démo, un par public (pour illustrer le cloisonnement)
MB_PILOTAGE_USER_EMAIL=pilote@chu.local
MB_PILOTAGE_USER_PASSWORD=pilote-demo-1
MB_RECHERCHE_USER_EMAIL=chercheur@chu.local
MB_RECHERCHE_USER_PASSWORD=chercheur-demo-1

# Hôte/port ClickHouse vus DEPUIS le conteneur Metabase (réseau compose)
MB_CH_HOST=clickhouse
MB_CH_PORT=8123
